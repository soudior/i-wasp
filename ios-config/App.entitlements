<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fichier de référence pour les entitlements iOS (Universal Links + NFC).
  À copier dans le projet Xcode généré : ios/App/App/App.entitlements,
  puis l'associer à la cible « App » (Build Settings → Code Signing Entitlements).
  Team ID : Y4JV4X2DJ6 · Bundle ID : app.iwasp.digital
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Universal Links -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:i-wasp.com</string>
        <string>applinks:www.i-wasp.com</string>
    </array>

    <!-- Core NFC tag sessions. Xcode 26 / iOS 15+ rejects the legacy NDEF entitlement. -->
    <key>com.apple.developer.nfc.readersession.formats</key>
    <array>
        <string>TAG</string>
    </array>
</dict>
</plist>
